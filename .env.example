ENVIRONMENT=local
AUDIT_LOG_PATH=./audit_events.jsonl
RULE_POLICY_PATH=../decision_engine/decision_engine/rules/borrow_better_v0_1.json

# Phase A database foundation (placeholder values only)
DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/<database>
DATABASE_REQUIRED=false
DATABASE_CONNECT_TIMEOUT=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800

# Phase B anonymous continuity
ANONYMOUS_SESSION_ALLOWED_ORIGINS=https://app.sutriva.com
ANONYMOUS_SESSION_PRODUCTION_ORIGIN=https://app.sutriva.com
ANONYMOUS_SESSION_ALLOW_INSECURE_LOCALHOST=false
ANONYMOUS_SESSION_COOKIE_NAME=sutriva_anon_session
ANONYMOUS_SESSION_COOKIE_MAX_AGE_SECONDS=7776000
ANONYMOUS_SESSION_ABSOLUTE_LIFETIME_SECONDS=7776000
ANONYMOUS_HISTORY_RETENTION_SECONDS=15552000
ANONYMOUS_TOKEN_RETENTION_SECONDS=15552000
ANONYMOUS_SESSION_TOKEN_GRACE_PERIOD_SECONDS=300
ANONYMOUS_RETENTION_PURGE_BATCH_SIZE=500

# Dedicated destructive-test controls (disabled by default)
PHASEA_TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/<database>_test
PHASEA_ALLOW_DESTRUCTIVE_DB_TESTS=0

# Phase 1.1B pilot OTP — empty on purpose. Never fill these in here; set real values only in the API
# service's actual secret environment (e.g. /etc/sutriva/api.env, mode 0600), never in Git, chat, or a
# log line. See docs/execution/TWILIO_PILOT_SMS.md for what each does, how to obtain it, and the
# India-specific delivery requirements that apply before any real send.
PILOT_SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
# Required independently of Twilio — without this the OTP service fails closed regardless of SMS
# provider.
PILOT_OTP_HMAC_KEYS=
# Optional, all with safe defaults (see services/api/app/pilot_config.py) — uncomment only to
# deliberately override.
# PILOT_OTP_CODE_LENGTH=6
# PILOT_OTP_TTL_SECONDS=600
# PILOT_OTP_RESEND_COOLDOWN_SECONDS=30
# PILOT_OTP_MAX_ATTEMPTS=5
# PILOT_OTP_MAX_SENDS_PER_REGISTRATION=5
# PILOT_OTP_MAX_SENDS_PER_PHONE=8
# PILOT_OTP_PHONE_SEND_WINDOW_HOURS=24
# PILOT_RATE_LIMIT_INTEREST_PER_IP_PER_HOUR=20
# PILOT_RATE_LIMIT_MOBILE_PER_IP_PER_HOUR=10
# PILOT_RATE_LIMIT_VERIFY_PER_IP_PER_HOUR=30
